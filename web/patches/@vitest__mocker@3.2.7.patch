diff --git a/dist/chunk-utils.js b/dist/chunk-utils.js
index 3916d3851d452b5a7d4c9ff01fedc4f2ddf22aa2..652dcdec4ff0880037bb11a4875df317852f6b4d 100644
--- a/dist/chunk-utils.js
+++ b/dist/chunk-utils.js
@@ -2,13 +2,17 @@ const postfixRE = /[?#].*$/;
 function cleanUrl(url) {
 	return url.replace(postfixRE, "");
 }
+// The module URL and every export name are written as JSON string literals, and
+// each named export goes through a string-named export specifier, so neither a
+// URL nor an export name can change the generated code (GHSA-qxg6-89mg-rqv8,
+// backport of @vitest/mocker 4.1.12).
 function createManualModuleSource(moduleUrl, exports, globalAccessor = "\"__vitest_mocker__\"") {
-	const source = `const module = globalThis[${globalAccessor}].getFactoryModule("${moduleUrl}");`;
-	const keys = exports.map((name) => {
+	const source = `const module = globalThis[${globalAccessor}].getFactoryModule(${JSON.stringify(moduleUrl)});`;
+	const keys = exports.map((name, index) => {
 		if (name === "default") {
 			return `export default module["default"];`;
 		}
-		return `export const ${name} = module["${name}"];`;
+		return `const __${index} = module[${JSON.stringify(name)}];\nexport { __${index} as ${JSON.stringify(name)} };`;
 	}).join("\n");
 	return `${source}\n${keys}`;
 }
