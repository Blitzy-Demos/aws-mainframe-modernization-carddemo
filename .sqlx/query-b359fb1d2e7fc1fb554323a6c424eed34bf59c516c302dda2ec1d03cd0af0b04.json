  "query": "SELECT accrual_id, account_id, transaction_id, rule_id, points_earned, created_at FROM reward_accruals WHERE account_id = $1 AND ($2::bigint IS NULL OR (created_at, accrual_id) <= (SELECT created_at, accrual_id FROM reward_accruals WHERE accrual_id = $2 AND account_id = $1)) ORDER BY created_at DESC, accrual_id DESC LIMIT $3",
