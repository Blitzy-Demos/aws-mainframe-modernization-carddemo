# CardDemo local settings.
#
# Every CARDDEMO_* setting with its local default. crates/runtime/src/config.rs
# applies the same defaults, so a .env is needed only to change a value:
#   cp .env.example .env
#   set -a; . ./.env; set +a
# .env is git-ignored. Credentials here are local configuration only.
#
# These defaults serve processes started on the host. The Compose `app` profile
# overrides CARDDEMO_DATABASE_URL, CARDDEMO_AMQP_URL, CARDDEMO_HTTP_ADDR
# (0.0.0.0:8080) and CARDDEMO_API_PROXY_TARGET (http://api:8080) with
# service-name values.

# --- Database ----------------------------------------------------------------
# PostgreSQL connection the api, mq and batch binaries open at run time.
# Matches the docker-compose.yml postgres service (database, user and password
# all `carddemo`).
CARDDEMO_DATABASE_URL=postgres://carddemo:carddemo@localhost:5432/carddemo
# Read at compile time by the sqlx query!/query_as! macros and by
# `cargo sqlx prepare --workspace [--check]`. With no database running, build
# with SQLX_OFFLINE=true against the committed .sqlx/ metadata instead.
DATABASE_URL=postgres://carddemo:carddemo@localhost:5432/carddemo

# --- Messaging ---------------------------------------------------------------
# RabbitMQ connection of the mq consumers. User carddemo/carddemo and vhost /
# (URL-encoded as %2f) are declared in infra/rabbitmq/definitions.json.
CARDDEMO_AMQP_URL=amqp://carddemo:carddemo@localhost:5672/%2f

# --- HTTP and auth -----------------------------------------------------------
# Listen address of the api binary.
CARDDEMO_HTTP_ADDR=127.0.0.1:8080
# HS256 secret the api signs and verifies POST /auth/login tokens with.
# Local-only value: never use it outside a development machine.
CARDDEMO_JWT_SECRET=local-dev-secret-change-me
# Lifetime of an issued token, in seconds: a positive integer. The api refuses
# to start with 0 or with a lifetime whose expiry no timestamp can represent.
CARDDEMO_JWT_TTL_SECS=3600

# --- Queues ------------------------------------------------------------------
# Request queues the mq consumers read: CDRD (CODATE01), CDRA (COACCT01) and
# CP00 (COPAUA0C). The reply and error queues CARD.DEMO.REPLY.DATE,
# CARD.DEMO.REPLY.ACCT and CARD.DEMO.ERROR are COBOL literals
# [app/app-vsam-mq/cbl/CODATE01.cbl:L147, L243]
# [app/app-vsam-mq/cbl/COACCT01.cbl:L198, L294] and are not configurable; CP00
# replies to each request's reply_to. The README queue names
# (CARDDEMO.REQUEST.QUEUE, AWS.M2.CARDDEMO.PAUTH.*) appear in no program and
# are not used.
CARDDEMO_QUEUE_DATE_REQUEST=CARD.DEMO.REQUEST.DATE
CARDDEMO_QUEUE_ACCT_REQUEST=CARD.DEMO.REQUEST.ACCT
CARDDEMO_QUEUE_PAUTH_REQUEST=CARD.DEMO.REQUEST.PAUTH

# --- Files -------------------------------------------------------------------
# Directory `batch creastmt` writes STATEMNT.PS, STATEMNT.HTML and
# STATEMNT.PS.PDF to.
CARDDEMO_STATEMENT_DIR=./var/statements/
# Directory of the GDG generation files the batch subcommands write and read,
# for example DALYREJS.G0001V00.
CARDDEMO_BATCH_DIR=./var/batch/
# ASCII fixture directory `batch seed` decodes to load the database.
CARDDEMO_FIXTURE_DIR=app/data/ASCII

# --- Web ---------------------------------------------------------------------
# Browser origin the api admits through CORS: the Vite dev server. Exactly one
# origin as a browser sends it: http:// or https://, a lower-case host and an
# optional non-default port, with no path or trailing /. The wildcard * is refused.
CARDDEMO_CORS_ORIGIN=http://localhost:5173
# Upstream of the Vite dev server's /api proxy, read by web/vite.config.ts.
CARDDEMO_API_PROXY_TARGET=http://127.0.0.1:8080

# --- Clock -------------------------------------------------------------------
# Unset by default, so the system clock applies. When set to an RFC 3339
# instant, every time-dependent output uses it: processing timestamps, CDRD
# date and time, reward accrual time and soft-delete time. Tests set it;
# Compose leaves it unset.
# CARDDEMO_CLOCK_OVERRIDE=2022-07-01T12:00:00Z

# --- Logging -----------------------------------------------------------------
# Filter for the JSON logs the api, mq and batch binaries write to stdout.
RUST_LOG=info
