# CardDemo configuration: every variable the code reads, with its local default.
# Copy to modern/.env (git-ignored) and change values there. No program loads .env by itself:
# the scripts in modern/scripts/ export it, and a manual shell runs `set -a; . ./.env; set +a`
# before starting a binary, Vite or Playwright. Plain POSIX KEY=value lines, so `.` sourcing
# works in sh and bash. Relative paths resolve against modern/, the working directory of every
# binary. Every value is local-only and matches compose.yaml; nothing names a hosted service.

# api, messaging, batch, carddemo-migrate; sqlx macros at build time unless SQLX_OFFLINE=true.
# User, password and database are compose.yaml's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
DATABASE_URL=postgres://carddemo:carddemo@localhost:5432/carddemo

# messaging: user carddemo of rabbitmq/definitions.json; vhost "/" URL-encoded as %2f.
CARDDEMO_AMQP_URL=amqp://carddemo:carddemo@localhost:5672/%2f

# messaging: CDRD (CODATE01) request queue.
CARDDEMO_QUEUE_REQUEST_DATE=CARD.DEMO.REQUEST.DATE

# messaging: CDRA (COACCT01) request queue.
CARDDEMO_QUEUE_REQUEST_ACCT=CARD.DEMO.REQUEST.ACCT

# messaging: CP00 (COPAUA0C) request queue. A renamed queue must be declared with the same
# dead-letter arguments (x-dead-letter-exchange "", x-dead-letter-routing-key
# CARD.DEMO.DEADLETTER.PAUTH), as docs/SETUP.md states.
CARDDEMO_QUEUE_REQUEST_PAUTH=CARD.DEMO.REQUEST.PAUTH

# messaging: milliseconds between basic_get polls of an empty request queue.
CARDDEMO_MQ_POLL_MS=250

# api (listen address); the Vite dev server's /api proxy target.
CARDDEMO_API_BIND=127.0.0.1:8080

# api: HS256 signing secret. Required: the API refuses to start when it is empty.
# Local-only placeholder, never a real secret.
CARDDEMO_JWT_SECRET=local-only-change-me

# api: token lifetime in seconds.
CARDDEMO_JWT_TTL_SECONDS=3600

# batch, api: root of the local output directories (dalyrejs/, systran/, reports/).
CARDDEMO_VAR_DIR=./var

# batch creastmt: statement output directory, on the local filesystem (no object storage).
CARDDEMO_STATEMENT_DIR=./var/statements/

# api: job decks written by endpoint 14 (CR00 report submission).
CARDDEMO_INTRDR_DIR=./var/jobs/

# batch load subcommands: ASCII fixture directory, read in place.
CARDDEMO_FIXTURE_DIR=../app/data/ASCII

# all binaries: unset leaves span export off; stdout enables the opentelemetry-stdout span
# exporter. There is no network exporter. With export on, each finished span is printed as a
# multi-line, human-readable text block (no source-location attributes) between the JSON event
# lines; a consumer that reads stdout line by line as JSON runs with export off.
# CARDDEMO_OTEL_EXPORT=stdout

# all binaries: tracing-subscriber env filter.
RUST_LOG=info

# sqlx macros: true builds against the committed .sqlx/ without a database. Left commented,
# because setting it here would change every build.
# SQLX_OFFLINE=true
